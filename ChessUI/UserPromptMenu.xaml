<UserControl x:Class="ChessUI.UserPromptMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ChessUI"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Width="300" Height="240" Style="{StaticResource BorderStyle}">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Your Info"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,15"
                       Style="{StaticResource TextStyle}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" Margin="0,0,10,10"
                       Style="{StaticResource TextStyle}" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="NameText" FontWeight="Bold" Margin="0,0,0,10"
                       Style="{StaticResource TextStyle}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="IP Address:" Margin="0,0,10,10"
                       Style="{StaticResource TextStyle}" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="IpText" FontWeight="Bold" Margin="0,0,0,10"
                       Style="{StaticResource TextStyle}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Port:" Margin="0,0,10,15"
                       Style="{StaticResource TextStyle}" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="PortText" FontWeight="Bold" Margin="0,0,0,15"
                       Style="{StaticResource TextStyle}" />

            <Button Grid.Row="4" Grid.ColumnSpan="2" Content="YES"
                    Style="{StaticResource ButtonStyle}"
                    Width="80" Height="30"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Click="Yes_Click" />
        </Grid>
    </Border>
</UserControl>
