<UserControl x:Class="ChessUI.PromotionMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ChessUI"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Width="275"
            Height="125"
            Style="{StaticResource BorderStyle}"
            >
        <!--Piece are looking good regardless of the scale-->
        <Grid RenderOptions.BitmapScalingMode="HighQuality">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1.5*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="SELECT A PIECE"
                   Grid.Row="0"
                   Style="{StaticResource TextStyle}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="Bold"/>
            <UniformGrid Grid.Row="1"
                         Rows="1"
                         Columns="4"
                         Cursor="Hand">
                <Image x:Name="QueenImage"
                       MouseDown="QueenImage_MouseDown"
                       Source="/Assets/QueenW.png"/>
                <Image x:Name="BishopImage"
                       MouseDown="BishopImage_MouseDown"
                       Source="/Assets/BishopW.png"/>
                <Image x:Name="RookImage"
                       MouseDown="RookImage_MouseDown"
                       Source="/Assets/RookW.png"/>
                <Image x:Name="KnightImage"
                       MouseDown="KnightImage_MouseDown"
                       Source="/Assets/KnightW.png"/>
            </UniformGrid>
        </Grid>

    </Border>
</UserControl>
